# ==========================================
# ⚡️ MINTOBOT ENVIRONMENT CONFIGURATION
# ==========================================
# Copy to .env in the repo root. The Python API (api/), the TypeScript bot
# (src/), and the website (web/ via vite envDir:'..') all read this file.

# 1. Telegram Bot Token (from @BotFather) — REQUIRED for the Telegram bot
TELEGRAM_BOT_TOKEN=

# 2. Telegram Admin User IDs (numeric, comma separated, from @userinfobot)
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ALLOWLIST_USER_IDS=

# Chat the API engine notifies on broadcast/confirm (your numeric TG id)
TELEGRAM_CHAT_ID=

# 3. Website public configuration
API_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
WALLETCONNECT_PROJECT_ID=

# 4. Chains
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
TELEGRAM_EXPLORER_BASE_URL=https://robinhoodchain.blockscout.com
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_CHAIN_ID=57073
INK_EXPLORER_URL=https://explorer.inkonchain.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_EXPLORER_URL=https://solscan.io

# 5. Runtime Configuration (TypeScript bot)
DB_PATH=./data/monitor.sqlite
POLL_INTERVAL_MS=5000
CONFIRMATIONS=12
MAX_BLOCK_RANGE=2000
REORG_REWIND_BLOCKS=20
WEBHOOK_PORT=8787

# 6. Secrets — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET=change-me-32-chars-min

# 7. Admin login (web console / API)
MINTOBABY_ADMIN_EMAIL=
MINTOBABY_ADMIN_PASSWORD=

# 8. Payments
PAYMENT_RECIPIENT=
WETH_ADDRESS=
PAYMENT_USD_AMOUNT=20
PAYMENT_CONFIRMATIONS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 9. Optional dedicated bot signer key
BOT_PRIVATE_KEY=
