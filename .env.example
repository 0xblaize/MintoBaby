# ==========================================
# ⚡️ MINTOBOT ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# 2. Telegram Admin User ID (your numerical ID from @userinfobot)
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ALLOWLIST_USER_IDS=


# 4. Robinhood Chain (4663) Network
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
TELEGRAM_EXPLORER_BASE_URL=https://robinhoodchain.blockscout.com

# 5. Runtime Configuration
DB_PATH=./data/monitor.sqlite
POLL_INTERVAL_MS=5000
CONFIRMATIONS=12
MAX_BLOCK_RANGE=2000
REORG_REWIND_BLOCKS=20
