{
  "policy_version": "2026-08-13-v1",
  "name": "mintobaby - Conservative Production Policy",
  "description": "Comprehensive policy for mintobaby. Restricts chain, contract addresses, calldata, approvals, values, gas, and requires manual approvals for new targets. Signing disabled by default.",
  "organization_id": "f1bda4e1-53f9-4c48-9ace-c61a29fcb40a",
  "enabled": true,
  "metadata": {
    "created_by": "operator",
    "created_at": "2026-08-13T00:00:00Z",
    "notes": "Keep signing disabled until contract schema and audit processes are finalized. Store private keys in secret manager."
  },
  "rules": {
    "allowed_chain_ids": [4663],
    "approved_contract_addresses": [],
    "allow_arbitrary_destination": false,
    "allow_calldata": false,
    "allow_contract_approvals": false,
    "allowed_transaction_types": ["mint","read"],
    "allowed_contract_methods": ["mintPrice","isPublicMintActive","totalSupply","balanceOf"],
    "max_mint_quantity": 1,
    "max_transaction_value_wei": "100000000000000000",
    "max_gas_fee_gwei": 50,
    "require_contract_schema_verified": true,
    "require_manual_approval_for_new_addresses": true,
    "disallow_proxy_contracts": true,
    "maximum_constructor_argument_count": 6
  },
  "permissions": {
    "create_wallet": true,
    "read_wallet": true,
    "sign_transactions": false,
    "signing_conditions": {
      "allowed": false,
      "allowed_after_manual_approval": false,
      "max_sign_value_wei": "0",
      "required_approver_roles": ["admin"],
      "approval_quorum": 1
    },
    "list_policies": false
  },
  "limits": {
    "per_wallet_tx_per_day": 10,
    "per_org_tx_per_day": 1000,
    "per_wallet_balance_limit_wei": "500000000000000000000"    
  },
  "approval_workflow": {
    "require_audit_report": true,
    "required_checks": [
      "rpc_chainid_check",
      "bytecode_exists",
      "required_methods_present",
      "public_mint_behavior_verified",
      "abi_schema_match"
    ],
    "approver_roles": ["admin"],
    "approval_record_required": true
  },
  "audit": {
    "webhook_on_violation": true,
    "webhook_endpoint": "",
    "webhook_signature_secret_name": "TURNKEY_WEBHOOK_SECRET",
    "email_notifications": [],
    "log_retention_days": 365
  },
  "monitoring": {
    "enable_metrics": true,
    "metric_namespace": "mintobaby.turnkey",
    "violation_alert_threshold": 1
  },
  "security": {
    "key_rotation_days": 90,
    "max_key_age_days": 365,
    "require_mfa_for_admins": true,
    "secret_storage": "external-vault"
  },
  "rate_limits": {
    "requests_per_minute": 60,
    "requests_burst": 120
  },
  "post_actions": {
    "require_manual_approval_before_enabling_signing": true,
    "notify_admins_on_new_target": true
  }
}
